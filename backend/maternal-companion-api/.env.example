# Copy to .env. For LOCAL development you can leave the secrets below commented out:
# the app then uses built-in dev-only values. (Do not set a secret to an empty value.)
ENVIRONMENT=local
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/maternal
REDIS_URL=redis://localhost:6379/0

# --- Required (real values, 32+ chars) when ENVIRONMENT is staging or production ---
# JWT_SECRET=
# PHONE_HASH_PEPPER=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FIELD_ENCRYPTION_KEY=

# WhatsApp (only needed when testing against Meta)
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
